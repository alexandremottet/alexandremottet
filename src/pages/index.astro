---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import Prose from '../layouts/Prose.astro';
import Gallery from '../layouts/Gallery.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(
  projects.map(async (project) => {
    const intro = await getEntry('home', project.id);
    return { project, Intro: intro ? (await render(intro)).Content : null };
  }),
);
---
<Base>
  <h1>alexandre mottet</h1>
  <h3>maker - créateur de produit</h3>
  <ul>
    {entries.map(({ project, Intro }) => (
      <li>
        <h2><a href={url(`/projects/${project.id}`)}>{project.data.title}</a></h2>
        <div class="row">
          <Prose>{Intro && <Intro />}</Prose>
          <Gallery images={project.data.images} />
        </div>
      </li>
    ))}
  </ul>
</Base>

<style is:global>
  ul { list-style: none; margin: 0; padding: 10vh 0 30vh; }
  li { padding: 2rem 0; opacity: 0.35; transition: opacity 0.3s ease; }
  li.active { opacity: 1; }
  h2 { margin: 0 0 1rem; font-size: 2.5rem; line-height: 1.1; font-weight: 700; transform-origin: left center; transition: transform 0.3s ease; }
  li.active h2 { transform: scale(1.3); }
  .row { display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); gap: 3rem; align-items: start; }
  @media (max-width: 800px) { .row { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } }
  h2 a { text-decoration: none; }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('li')];
  const anchor = () => innerHeight * 0.3;
  let active = -1;

  const setActive = (i: number) => {
    if (i === active) return;
    items[active]?.classList.remove('active');
    items[i].classList.add('active');
    active = i;
  };

  const update = () => {
    let best = 0;
    items.forEach((el, i) => {
      if (el.getBoundingClientRect().top <= anchor() + 1) best = i;
    });
    setActive(best);
  };

  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { update(); ticking = false; });
  }, { passive: true });

  addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      const g = items[active]?.querySelector<HTMLElement>('.gallery');
      if (!g) return;
      e.preventDefault();
      g.scrollBy({ left: (e.key === 'ArrowRight' ? 1 : -1) * g.clientWidth * 0.8, behavior: 'smooth' });
      return;
    }
    const step = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
    if (!step) return;
    e.preventDefault();
    const next = Math.min(items.length - 1, Math.max(0, active + step));
    scrollTo({ top: items[next].offsetTop - anchor(), behavior: 'smooth' });
  });

  update();
</script>
