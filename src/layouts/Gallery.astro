---
import { Image, type ImageMetadata } from 'astro:assets';

interface Props { images: { src: ImageMetadata; alt: string }[] }
const { images } = Astro.props;
---
{images &&  images.length > 0 && (
  <div class="gallery">
    {images.map((img) => <Image src={img.src} alt={img.alt} height={600} />)}
  </div>
)}

<style>
  .gallery { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
  .gallery::-webkit-scrollbar { display: none; }
  .gallery :global(img) { height: 22rem; width: auto; flex: none; scroll-snap-align: start; }
</style>
